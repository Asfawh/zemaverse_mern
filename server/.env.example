PORT=8004
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/ZemaVerse?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-value
# Private Cloudflare Turnstile secret key. Local development automatically uses
# Cloudflare's always-pass test secret when this is omitted.
TURNSTILE_SECRET_KEY=
# Comma-separated production hostnames accepted from Cloudflare verification.
TURNSTILE_HOSTNAMES=zemaverse.com,www.zemaverse.com
